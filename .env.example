# Required
TELEGRAM_BOT_TOKEN=ضع_توكن_البوت_هنا

# Railway injects PORT automatically; keep this only for local development.
PORT=3000

# Persistent storage. On Railway attach a Volume mounted at /app/data.
DATA_DIR=/app/data
DATABASE_PATH=/app/data/study_bot.sqlite3

# Usage limits
MAX_TASKS=20
MAX_TASK_CHARS=180
MAX_SESSION_MINUTES=720

# Time and concurrency
CLOCK_OFFSET_MINUTES=0
UPDATE_CONCURRENCY=8
CONNECTION_POOL_SIZE=16
POOL_TIMEOUT_SECONDS=5
TIMER_UPDATE_SECONDS=1

# Telegram numeric user IDs allowed to open /admin, comma-separated
OWNER_IDS=

# Public channel usernames, comma-separated; the bot must be able to verify members
FORCE_SUBSCRIPTION_CHANNELS=

# Send one random motivational video after each completed session
MOTIVATION_VIDEOS_ENABLED=true
